{
  "name": "imageincam",
  "version": "1.0.0",
  "description": "Make photos appear on your cam with gestures",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "assets": "node scripts/copy-assets.js"
  },
  "build": {
    "appId": "com.jmond07.imageincam",
    "productName": "ImageInCam",
    "files": ["main.js", "preload.js", "package.json", "src/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmond07/ImageInCam.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jmond07/ImageInCam/issues"
  },
  "homepage": "https://github.com/jmond07/ImageInCam#readme",
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}